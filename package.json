{
  "name": "zakir-desktop",
  "private": true,
  "version": "1.0.0",
  "productName": "Zakir — Institutional Decision Intelligence",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=api/_server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron server.js",
    "lint": "tsc --noEmit",
    "build:electron": "rm -rf dist-electron && esbuild electron/main.ts --bundle --platform=node --format=esm --outfile=dist-electron/main.mjs --external:electron --external:electron-updater && esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron",
    "electron:start": "cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron .",
    "electron:wait": "wait-on tcp:3000 && npm run electron:start",
    "electron:dev": "concurrently -k \"npm run dev\" \"npm run electron:wait\"",
    "electron:build": "npm run build && npm run build:electron && electron-builder build",
    "electron:publish": "npm run build && npm run build:electron && electron-builder build --publish always"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.3.0",
    "nodemailer": "^6.9.16",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.0",
    "resend": "^6.18.1",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.11",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vite": "^6.2.3"
  }
}
