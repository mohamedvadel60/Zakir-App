# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="AQ.Ab8RN6JA9TBAz03QrFC_kJRiQpD_6cGb39axCwr30VrK5xufww"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://getzakir.com"
VITE_API_BASE_URL="https://getzakir.com"
VITE_BACKEND_URL="https://getzakir.com"

# RENDER_API_KEY: Optional/Required for listing Render.com services.
# Users can also configure this securely in the UI.
RENDER_API_KEY=

# STRIPE_SECRET_KEY: Required for live Stripe Checkout and Subscription Portal integration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLIC_KEY=

# TRANSACTIONAL EMAIL PROVIDER: Use Resend ONLY for production OTP verification & password resets.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
# EMAIL_FROM: Must use a verified custom domain, e.g., "Your App <no-reply@yourdomain.com>"
EMAIL_FROM="Your App <no-reply@yourdomain.com>"

RESEND_API_KEY=
RESEND_FROM=

# VITE_DESKTOP_DOWNLOAD_URL: Direct installer .exe download link from GitHub Releases.
VITE_DESKTOP_DOWNLOAD_URL="https://github.com/mohamedvadel60/Zakir-Web-App/releases/download/v1.0.0/Zakir-Setup-1.0.0.exe"

# FIREBASE ADMIN CREDENTIALS: Required for production (Vercel) Firestore/Auth access.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# 21st.dev CLI API Key
API_KEY_21ST=
