rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == "mohamedvadel60@mail.com" ||
        request.auth.token.email == "mohamedvadel60@gmail.com" ||
        request.auth.token.email == "mohamedvadhil0@gmail.com"
      );
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isWorkspaceMember(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserData(request.auth.uid).workspace.ownerId == userId
        )
      );
    }

    // Authoritative check: User is approved, email verified, and has an active subscription OR unexpired trial
    function isUserEntitled(userId) {
      return isAdmin() || (
        exists(/databases/$(database)/documents/users/$(userId)) &&
        (
          let u = getUserData(userId);
          (u.role == "Admin") ||
          (
            (u.isEmailVerified == true || u.verification_required == false) &&
            u.accountStatus == "APPROVED" &&
            (
              u.subscriptionStatus == "Active" ||
              (
                u.subscriptionStatus != "Expired" &&
                (
                  (u.trialExpiresAtMillis != null && request.time.toMillis() < u.trialExpiresAtMillis) ||
                  (u.trialExpiresAt != null && u.trialExpiresAt is timestamp && request.time < u.trialExpiresAt) ||
                  (u.trialEndsAt != null && u.trialEndsAt is timestamp && request.time < u.trialEndsAt)
                )
              )
            )
          )
        )
      );
    }

    function canAccessUserData(userId) {
      return (isOwner(userId) || isWorkspaceMember(userId) || isAdmin()) && isUserEntitled(userId);
    }

    // User profile document and subcollections
    match /users/{userId} {
      allow read: if isOwner(userId) || isWorkspaceMember(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      // Block regular users from modifying any entitlement, subscription, trial, or lifecycle fields
      allow update: if (isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'roles', 'isAdmin', 'accountStatus', 'subscriptionPlan', 'plan',
          'trialExpiresAt', 'trialExpiresAtMillis', 'trialStartedAt', 'trialEndsAt',
          'isTrial', 'stripeSubscriptionId', 'subscriptionStatus', 'entitlement',
          'powers', 'institutionalProfile', 'verification_required', 'isEmailVerified',
          'verificationInfo', 'verification_status', 'rejectionReason', 'approvedAt',
          'approvedBy', 'approvalNotes', 'adminVerificationOverride', 'isVerified', 'verifiedAt'
        ])
      )) || isAdmin();
      allow delete: if isAdmin();

      match /memories/{memoryId} {
        allow read, create, update, delete: if canAccessUserData(userId);
      }

      match /riskAlerts/{alertId} {
        allow read, create, update, delete: if canAccessUserData(userId);
      }

      match /files/{fileId} {
        allow read, create, delete: if canAccessUserData(userId);
        allow update: if canAccessUserData(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'subscriptionPlan', 'trialExpiresAt', 'trialExpiresAtMillis',
            'stripeSubscriptionId', 'subscriptionStatus'
          ])
        );
      }

      match /{document=**} {
        allow read, create, delete: if canAccessUserData(userId);
        allow update: if canAccessUserData(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'subscriptionPlan', 'trialExpiresAt', 'trialExpiresAtMillis',
            'stripeSubscriptionId', 'subscriptionStatus'
          ])
        );
      }
    }

    // Top-level files metadata
    match /files/{fileId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && isUserEntitled(request.auth.uid))
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.resource.data.userId == request.auth.uid && isUserEntitled(request.auth.uid))
      );
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && isUserEntitled(request.auth.uid))
      ) && (request.resource == null || request.resource.data.userId == resource.data.userId);
    }

    // Subscription Correction Requests
    match /subscription_correction_requests/{requestId} {
      allow read: if (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userEmail == request.auth.token.email)) || isAdmin();
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Authoritative Audit Logs & Entitlement Audit Logs
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /entitlement_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Verification codes collection - secure server-only / admin-only
    match /verification_codes/{codeId} {
      allow read, write: if isAdmin();
    }

    // Authoritative deleted users list
    match /deletedUsers/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // Workspace Invitations
    match /invitations/{invitationId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Permanent Account Lifecycle & Reactivation Requests
    match /accountLifecycle/{accountId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.originalUserId == request.auth.uid));
      allow write: if isAdmin();
    }

    match /accountReactivationRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /users_retained/{userId} {
      allow read, write: if isAdmin();
    }

    // Identity Verification & Recovery Documents
    match /recoveryDocuments/{documentId} {
      allow read, write: if isAdmin();
      match /chunks/{chunkId} {
        allow read, write: if isAdmin();
      }
    }

    match /recoveryRequests/{requestId} {
      allow read, write: if isAdmin();
    }

    match /recoveryRequests_by_email/{email} {
      allow read, write: if isAdmin();
    }

    // Customer Support Tickets
    match /support_tickets/{ticketId} {
      allow read: if (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userEmail == request.auth.token.email)) || isAdmin();
      allow create: if true;
      allow update, delete: if (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userEmail == request.auth.token.email)) || isAdmin();
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Real-Time Platform Events, Incidents & Admin Notifications
    match /platform_events/{eventId} {
      allow read, write: if isAdmin();
    }

    match /platform_incidents/{incidentId} {
      allow read, write: if isAdmin();
    }

    match /admin_notifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
